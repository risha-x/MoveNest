{
  "name": "movenest-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test:db": "tsx --env-file=.env src/scripts/test-supabase-connection.ts",
    "test:supabase-admin": "tsx --env-file=.env src/scripts/test-supabase-admin.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  }
}
