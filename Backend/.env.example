# Copy this file to .env and fill in real values from your Supabase project.
# Everything here is SECRET - never commit the real .env, never share these
# values in chat, never expose them to frontend code.

# Settings > API > "Secret key" (bypasses Row Level Security - backend only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Settings > Database > Connection string ("Direct connection" or "ORM" tab)
DATABASE_URL=
